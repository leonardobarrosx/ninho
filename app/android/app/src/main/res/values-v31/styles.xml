<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw their own launch screen. It gets the page background and
         the same logo as launch_background.xml, in the middle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ninho_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ninho_background</item>
    </style>
</resources>
