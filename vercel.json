{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build_web.sh",
  "outputDirectory": "dist",
  "installCommand": "echo 'Flutter dependencies are installed during build'",
  "redirects": [
    {"source": "/app", "destination": "/app/", "permanent": true}
  ],
  "rewrites": [
    {"source": "/privacidade", "destination": "/privacidade.html"},
    {"source": "/excluir-conta", "destination": "/excluir-conta.html"},
    {"source": "/app/((?!.*\\.).*)", "destination": "/app/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/app/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/app/flutter_bootstrap.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
